<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payout_list" model="ir.ui.view">
        <field name="name">workset.agent.payout.list</field>
        <field name="model">workset.agent.payout</field>
        <field name="arch" type="xml">
            <list string="Виплати агентам" create="0">
                <field name="pay_day"/>
                <field name="agent_id"/>
                <field name="section" optional="hide"/>
                <field name="pay_path"/>
                <field name="gross" sum="Разом" optional="show"/>
                <field name="net" sum="Разом"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state in ('review', 'paid_part')"/>
                <field name="paid_date" optional="show"/>
                <field name="iban" optional="hide" groups="account.group_account_user,hr.group_hr_manager"/>
                <field name="purpose" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- телефон: картка ≤ 4 рядків — агент і статус, сума до переказу, день виплати -->
    <record id="view_payout_kanban" model="ir.ui.view">
        <field name="name">workset.agent.payout.kanban</field>
        <field name="model">workset.agent.payout</field>
        <field name="arch" type="xml">
            <kanban create="0" records_draggable="0" quick_create="0">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="agent_id" class="fw-bold text-truncate"/>
                            <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state in ('review', 'paid_part')"/>
                        </div>
                        <field name="net" widget="monetary" class="fs-4 fw-bold"/>
                        <div class="small text-muted">день виплати <field name="pay_day"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_payout_form" model="ir.ui.view">
        <field name="name">workset.agent.payout.form</field>
        <field name="model">workset.agent.payout</field>
        <field name="arch" type="xml">
            <form string="Виплата агенту" create="0">
                <header>
                    <button name="action_paid_manual" type="object" string="Позначити виплаченим вручну" class="btn-primary"
                            invisible="state in ('paid', 'paid_part', 'cancelled')" groups="account.group_account_user,workset_agents.group_owner"/>
                    <field name="state" widget="statusbar" statusbar_visible="prep,bill,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Кому і коли">
                            <field name="agent_id"/>
                            <field name="section"/>
                            <field name="pay_path"/>
                            <field name="company_id"/>
                            <field name="pay_day"/>
                            <field name="work_month"/>
                            <field name="decision_id"/>
                        </group>
                        <group string="Гроші">
                            <field name="gross"/>
                            <field name="tax20"/>
                            <field name="wh10"/>
                            <field name="net"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_id"/>
                            <field name="iban" groups="account.group_account_user,hr.group_hr_manager"/>
                            <field name="purpose"/>
                        </group>
                    </group>
                    <group string="Оплата" invisible="not paid_date and not paid_amount and not paid_note">
                        <field name="paid_date"/>
                        <field name="paid_via"/>
                        <field name="paid_amount"/>
                        <field name="move_line_id"/>
                        <field name="paid_manual"/>
                        <field name="paid_by"/>
                        <field name="paid_note"/>
                    </group>
                    <group string="Сторож" invisible="not guard">
                        <field name="guard"/>
                        <field name="guard_note"/>
                    </group>
                    <notebook>
                        <page string="Нарахування у виплаті" name="accruals">
                            <field name="accrual_ids" readonly="1">
                                <list>
                                    <field name="earned_date"/>
                                    <field name="kind"/>
                                    <field name="amount" sum="Разом"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Нотатки" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payout_search" model="ir.ui.view">
        <field name="name">workset.agent.payout.search</field>
        <field name="model">workset.agent.payout</field>
        <field name="arch" type="xml">
            <search string="Виплати агентам">
                <field name="agent_id"/>
                <filter name="open" string="Не виплачено" domain="[('state', 'not in', ['paid', 'paid_part', 'cancelled'])]"/>
                <filter name="review" string="На перевірці" domain="[('state', '=', 'review')]"/>
                <group>
                    <filter name="by_agent" string="Агент" context="{'group_by': 'agent_id'}"/>
                    <filter name="by_day" string="День виплати" context="{'group_by': 'pay_day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payouts" model="ir.actions.act_window">
        <field name="name">Виплати</field>
        <field name="res_model">workset.agent.payout</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_payout_search"/>
    </record>

    <!-- «Позначити виплаченим вручну» — у меню дій списку виплат (бухгалтерія й власник) -->
    <record id="action_server_paid_manual" model="ir.actions.server">
        <field name="name">Позначити виплаченим вручну</field>
        <field name="model_id" ref="model_workset_agent_payout"/>
        <field name="binding_model_id" ref="model_workset_agent_payout"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_paid_manual()</field>
    </record>
</odoo>
