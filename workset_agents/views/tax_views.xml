<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_list" model="ir.ui.view">
        <field name="name">workset.agent.tax.list</field>
        <field name="model">workset.agent.tax</field>
        <field name="arch" type="xml">
            <list string="Податки агентів">
                <field name="agent_id" string="Агент"/>
                <field name="tax_status" string="Статус" widget="badge"/>
                <field name="tax_country" string="Країна"/>
                <field name="cert_until" string="Довідка до"/>
            </list>
        </field>
    </record>

    <record id="view_tax_form" model="ir.ui.view">
        <field name="name">workset.agent.tax.form</field>
        <field name="model">workset.agent.tax</field>
        <field name="arch" type="xml">
            <form string="Податки агента">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <field name="agent_id"/>
                        <field name="tax_status"/>
                        <field name="tax_country"/>
                        <field name="cert_until"/>
                        <field name="tax_number"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tax_search" model="ir.ui.view">
        <field name="name">workset.agent.tax.search</field>
        <field name="model">workset.agent.tax</field>
        <field name="arch" type="xml">
            <search string="Податки агентів">
                <field name="agent_id"/>
                <filter name="no_cert" string="Без довідки" domain="[('cert_until', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_tax" model="ir.actions.act_window">
        <field name="name">Податки</field>
        <field name="res_model">workset.agent.tax</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tax_search"/>
    </record>
</odoo>
