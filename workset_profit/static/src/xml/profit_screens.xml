<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Екрани «Прибутковості» за макетами A, B, C (06.11): стиль «Огляду ставок» — підпис зверху, крупне число, «€ год» дрібно сірим;
         колір лише в тривог (червоне — чисто нижче нуля, жовте — тривога), решта — класи й змінні теми Bootstrap (світла й темна). Даних
         немає — один рядок «немає даних за <місяць>», без нулів і порожніх рамок. Сітки (scss) — без порожніх полів, на телефоні в один
         стовпець; таблиця C гортається вбік із закріпленою колонкою «Лінія» -->

    <!-- ——— A «Огляд» ——— -->
    <t t-name="workset_profit.Overview">
        <div class="o_action o_workset_profit">
            <Layout display="{ controlPanel: {} }" className="'o_workset_profit_main overflow-auto'">
                <div class="container-fluid py-3" t-if="data">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <span class="fs-4">Прибутковість ліній</span>
                        <Dropdown>
                            <button class="btn btn-secondary"><i class="fa fa-calendar me-2"/><t t-esc="data.month.label"/></button>
                            <t t-set-slot="content">
                                <t t-foreach="data.months" t-as="m" t-key="m.value">
                                    <DropdownItem onSelected="() => this.setMonth(m.value)"><t t-esc="m.label"/></DropdownItem>
                                </t>
                            </t>
                        </Dropdown>
                    </div>

                    <t t-if="data.has">
                        <!-- п'ять підсумків місяця по лініях: «Чисто» — головне число кольором бренду (нижче нуля — червоним) -->
                        <t t-set="tot" t-value="data.totals"/>
                        <div class="card o_workset_profit_band mb-3">
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Годин</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num" t-esc="plain(tot.hours)"/>
                                <span t-if="tot.hours_no_rate" class="small text-muted">зі ставкою <t t-esc="plain(tot.hours_rate)"/></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Частка WorkSET</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num"><t t-esc="perHour(tot.share_ph)"/><span class="o_workset_profit_unit text-muted fw-normal">€ год</span></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center" title="Оренда авто плюсом; житло, авто, паливо, інструмент, перевезення — мінусом">
                                <span class="d-block text-muted text-truncate">Житло, авто, паливо, інструмент</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num"><t t-esc="perHour(tot.costs_ph)"/><span class="o_workset_profit_unit text-muted fw-normal">€ год</span></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Чисто</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num" t-att-class="tot.net &lt; 0 ? 'text-danger' : 'text-primary'"><t t-esc="perHour(tot.net_ph)"/><span class="o_workset_profit_unit text-muted fw-normal">€ год</span></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Чисто за місяць</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num" t-att-class="tot.net &lt; 0 ? 'text-danger' : ''"><t t-esc="euros(tot.net)"/><span class="o_workset_profit_unit text-muted fw-normal">€</span></span>
                            </div>
                        </div>

                        <!-- тривоги: підпис, лічильник у сірій капсулі, крапка кольору тривоги; клік — список рядків («Звірка» — її текст) -->
                        <div t-if="data.alerts.length" class="o_workset_profit_chips mb-4">
                            <t t-foreach="data.alerts" t-as="a" t-key="a_index">
                                <button type="button" class="card o_workset_profit_chip flex-row align-items-center gap-2 px-3 py-2 text-start" t-on-click="() => this.onAlert(a)">
                                    <t t-if="a.key === 'unallocated'">
                                        <span class="flex-grow-1 text-truncate">Не розподілено</span>
                                        <span class="badge rounded-pill o_workset_profit_count"><t t-esc="euros(a.amount)"/> €</span>
                                    </t>
                                    <t t-elif="a.key === 'no_rate'">
                                        <span class="flex-grow-1 text-truncate">Години без ставки</span>
                                        <span class="badge rounded-pill o_workset_profit_count" t-esc="plain(a.hours)"/>
                                    </t>
                                    <t t-elif="a.key === 'noline'">
                                        <span class="flex-grow-1 text-truncate">Години без лінії</span>
                                        <span class="badge rounded-pill o_workset_profit_count" t-esc="plain(a.hours)"/>
                                    </t>
                                    <t t-elif="a.key === 'housing_shift'">
                                        <span class="flex-grow-1 text-truncate">Житло не в своєму місяці</span>
                                        <span class="badge rounded-pill o_workset_profit_count" t-esc="a.count"/>
                                    </t>
                                    <t t-elif="a.key === 'owner'">
                                        <span class="flex-grow-1 text-truncate">Власник <t t-esc="a.code"/></span>
                                        <span class="badge rounded-pill o_workset_profit_count"><t t-esc="euros(a.amount)"/> €</span>
                                    </t>
                                    <t t-elif="a.key === 'check'">
                                        <span t-if="a.state === 'ok'" class="flex-grow-1 text-truncate" t-att-title="a.text">Звірка зійшлася <i class="fa fa-check ms-1"/></span>
                                        <span t-else="" class="flex-grow-1 text-truncate" t-att-title="a.text">Звірка: розбіжність</span>
                                    </t>
                                    <span t-if="alertTone(a)" class="o_workset_profit_dot rounded-circle flex-shrink-0" t-att-class="alertTone(a)"/>
                                </button>
                            </t>
                        </div>

                        <!-- плитки ліній: «частка X → чисто», крупно чисто € год, € за місяць і стрілка до минулого місяця; житло не з наших грошей — чипом -->
                        <div class="fs-4 mb-2">Лінії</div>
                        <div class="o_workset_profit_tiles mb-4">
                            <t t-foreach="data.lines" t-as="line" t-key="line.id">
                                <button type="button" class="card text-start p-3 o_workset_profit_tile" t-on-click="() => this.openLine(line)">
                                    <div class="fs-5 fw-semibold text-truncate w-100" t-att-class="line.tone === 'neg' ? 'text-danger' : ''" t-esc="line.name"/>
                                    <div class="d-flex flex-wrap gap-1 o_workset_profit_tile_badges">
                                        <span class="badge rounded-pill o_workset_profit_count">частка <t t-esc="perHour(line.share_ph)"/> → чисто</span>
                                        <span t-if="line.housing_from === 'partner'" class="badge rounded-pill o_workset_profit_count">житло з буфера лінії</span>
                                        <span t-elif="line.housing_from === 'worker_fund'" class="badge rounded-pill o_workset_profit_count">житло з фонду працівників</span>
                                    </div>
                                    <div class="o_workset_profit_big" t-att-class="line.tone === 'neg' ? 'text-danger' : ''"><t t-esc="perHour(line.net_ph)"/><span class="o_workset_profit_unit text-muted fw-normal">€ год</span></div>
                                    <div class="text-nowrap" t-att-class="line.tone === 'neg' ? 'text-danger' : 'text-muted'">
                                        <t t-esc="euros(line.net)"/> € за місяць
                                        <span t-if="line.trend and line.trend.dir !== 'same'" class="ms-1" title="до минулого місяця, € год">
                                            <i t-att-class="line.trend.dir === 'down' ? 'fa fa-arrow-down' : 'fa fa-arrow-up'"/>
                                            <t t-esc="plain(line.trend.delta)"/>
                                        </span>
                                    </div>
                                </button>
                            </t>
                        </div>
                    </t>
                    <div t-else="" class="alert alert-info">немає даних за <t t-esc="data.month.label"/></div>

                    <div class="o_workset_profit_panels">
                        <div t-if="hasSeries" class="card">
                            <div class="card-header fw-semibold">Чисто по місяцях, <span class="text-muted fw-normal">€ год</span></div>
                            <div class="card-body">
                                <div class="o_workset_profit_chart"><canvas t-ref="chart"/></div>
                                <div class="small text-muted mt-2">Усі лінії разом — жирно, кожна лінія — тонко.</div>
                            </div>
                        </div>
                        <!-- «Куди йде частка»: смуга на лінію — чисто, житло, авто, паливо, інструмент, перевезення (частки від суми) -->
                        <div t-if="data.has" class="card">
                            <div class="card-header fw-semibold">Куди йде частка</div>
                            <div class="card-body">
                                <t t-foreach="data.lines" t-as="line" t-key="line.id">
                                    <button type="button" class="o_workset_profit_split_row" t-on-click="() => this.openLine(line)">
                                        <span class="small text-truncate text-start" t-esc="line.name"/>
                                        <span class="o_workset_profit_split_bar">
                                            <t t-foreach="line.split" t-as="p" t-key="p.key">
                                                <span t-attf-class="o_workset_profit_part o_workset_profit_part_{{p.key}}" t-attf-style="width: {{p.pct}}%;"
                                                      t-att-title="euros(p.amount) + ' €'"/>
                                            </t>
                                        </span>
                                    </button>
                                </t>
                                <div class="d-flex flex-wrap gap-3 small mt-3">
                                    <span><span class="o_workset_profit_key o_workset_profit_part_net"/>чисто</span>
                                    <span><span class="o_workset_profit_key o_workset_profit_part_housing"/>житло</span>
                                    <span><span class="o_workset_profit_key o_workset_profit_part_auto"/>авто</span>
                                    <span><span class="o_workset_profit_key o_workset_profit_part_fuel"/>паливо</span>
                                    <span><span class="o_workset_profit_key o_workset_profit_part_tool"/>інструмент</span>
                                    <span><span class="o_workset_profit_key o_workset_profit_part_transport"/>перевезення</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <!-- ——— B «Картка лінії» ——— -->
    <t t-name="workset_profit.LineCard">
        <div class="o_action o_workset_profit">
            <Layout display="{ controlPanel: {} }" className="'o_workset_profit_main overflow-auto'">
                <div class="container-fluid py-3" t-if="data">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <span class="fs-4 text-truncate"><t t-if="data.line" t-esc="data.line.name"/><t t-else="">Ліній за місяць немає</t></span>
                        <div class="d-flex align-items-center gap-1">
                            <span class="btn btn-secondary pe-none" t-esc="data.month.title"/>
                            <button type="button" class="btn btn-secondary" t-att-disabled="!data.prev" title="Минулий місяць" t-on-click="() => this.go(data.prev)"><i class="fa fa-chevron-left"/></button>
                            <button type="button" class="btn btn-secondary" t-att-disabled="!data.next" title="Наступний місяць" t-on-click="() => this.go(data.next)"><i class="fa fa-chevron-right"/></button>
                        </div>
                    </div>

                    <t t-if="data.has">
                        <t t-set="tot" t-value="data.totals"/>
                        <div class="card o_workset_profit_band mb-3">
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Години</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num" t-esc="plain(tot.hours)"/>
                                <span t-if="tot.hours_no_rate" class="small text-muted">зі ставкою <t t-esc="plain(tot.hours_rate)"/></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Частка WorkSET</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num"><t t-esc="perHour(tot.share_ph)"/><span class="o_workset_profit_unit text-muted fw-normal">€ год</span></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Витрати на лінію</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num"><t t-esc="perHour(tot.costs_ph)"/><span class="o_workset_profit_unit text-muted fw-normal">€ год</span></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-truncate fw-semibold" t-att-class="tot.net &lt; 0 ? 'text-danger' : 'text-primary'">Чисто</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num" t-att-class="tot.net &lt; 0 ? 'text-danger' : 'text-primary'"><t t-esc="perHour(tot.net_ph)"/><span class="o_workset_profit_unit text-muted fw-normal">€ год</span></span>
                            </div>
                            <div class="o_workset_profit_band_cell text-center">
                                <span class="d-block text-muted text-truncate">Чисто за місяць</span>
                                <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_profit_num" t-att-class="tot.net &lt; 0 ? 'text-danger' : ''"><t t-esc="euros(tot.net)"/><span class="o_workset_profit_unit text-muted fw-normal">€</span></span>
                            </div>
                        </div>

                        <div class="o_workset_profit_card_top mb-3">
                            <!-- водоспад: € над стовпцем (витрата — під ним), назва й € год під полем; нульових кроків немає -->
                            <div class="card">
                                <div class="card-header fw-semibold">Від частки до чистого, <t t-esc="data.month.name"/></div>
                                <div class="card-body">
                                    <div class="o_workset_profit_fall">
                                        <t t-foreach="data.waterfall.bars" t-as="b" t-key="b.key">
                                            <div class="o_workset_profit_fall_col">
                                                <div class="o_workset_profit_fall_area">
                                                    <div class="o_workset_profit_fall_bar" t-att-class="barClass(b)" t-att-style="barStyle(b)"/>
                                                    <div class="o_workset_profit_fall_value small fw-semibold text-nowrap" t-att-style="valueStyle(b)"><t t-esc="euros(b.amount)"/> €</div>
                                                </div>
                                                <div class="small text-center mt-1">
                                                    <div class="text-truncate" t-att-class="b.key === 'net' ? 'fw-semibold' : ''" t-att-title="b.label" t-esc="b.label"/>
                                                    <div class="text-muted text-nowrap"><t t-esc="perHour(b.ph)"/> € год</div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-3">
                                <div class="card">
                                    <div class="card-header fw-semibold">Хто платить</div>
                                    <ul class="list-group list-group-flush">
                                        <t t-foreach="data.pays" t-as="p" t-key="p.key">
                                            <li class="list-group-item">
                                                <div><t t-esc="p.label"/> — <t t-esc="p.payer"/><t t-if="p.cards.length">, DKV: <t t-esc="p.cards.join(', ')"/></t></div>
                                                <div t-foreach="p.except" t-as="ex" t-key="ex_index" class="small text-muted ps-3"><t t-esc="ex.name"/> — <t t-esc="ex.payer"/></div>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                                <div t-if="data.aside.length" class="card bg-body-tertiary">
                                    <div class="card-header fw-semibold text-muted">Не в нашому чисто</div>
                                    <ul class="list-group list-group-flush">
                                        <t t-foreach="data.aside" t-as="item" t-key="item.key">
                                            <li class="list-group-item bg-transparent d-flex justify-content-between gap-2">
                                                <span t-esc="item.label"/><span class="text-nowrap"><t t-esc="euros(item.amount)"/> €</span>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div t-elif="data.line" class="alert alert-info">немає даних за <t t-esc="data.month.label"/></div>

                    <div class="o_workset_profit_panels">
                        <div t-if="data.series and data.series.net.some((v) => v !== null)" class="card">
                            <div class="card-header fw-semibold">Чисто по місяцях, <span class="text-muted fw-normal">€ год</span></div>
                            <div class="card-body">
                                <div class="o_workset_profit_chart"><canvas t-ref="chart"/></div>
                                <div class="small text-muted mt-2">Стовпці — чисто, тонка лінія — частка WorkSET.</div>
                            </div>
                        </div>
                        <div t-if="data.has" class="card">
                            <div class="card-header fw-semibold">Рядки за <t t-esc="data.month.name"/></div>
                            <div class="list-group list-group-flush">
                                <t t-foreach="data.rows" t-as="r" t-key="r_index">
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2"
                                            t-att-class="r.open ? '' : 'pe-none'" t-on-click="() => this.openList(r.open)">
                                        <span class="text-truncate">
                                            <span class="d-block text-truncate" t-att-title="r.title" t-esc="r.title"/>
                                            <span t-if="r.sub" class="d-block small text-muted text-truncate" t-esc="r.sub"/>
                                        </span>
                                        <span class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span t-if="r.amount !== null" class="text-nowrap" t-att-class="r.chain ? '' : 'text-muted'"><t t-esc="euros(r.amount)"/> €</span>
                                            <i t-if="r.open" class="fa fa-chevron-right text-muted"/>
                                        </span>
                                    </button>
                                </t>
                                <div t-if="data.rows_total &gt; data.rows.length" class="list-group-item small text-muted">
                                    Показано <t t-esc="data.rows.length"/> з <t t-esc="data.rows_total"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <!-- ——— C «Лінії × місяці» ——— -->
    <t t-name="workset_profit.Matrix">
        <div class="o_action o_workset_profit">
            <Layout display="{ controlPanel: {} }" className="'o_workset_profit_main overflow-auto'">
                <div class="container-fluid py-3" t-if="data">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fs-4 me-2">Лінії × місяці</span>
                            <select class="form-select w-auto" aria-label="З місяця" t-on-change="(ev) => this.setFrom(ev.target.value)">
                                <t t-foreach="data.options" t-as="m" t-key="m.value">
                                    <option t-att-value="m.value" t-att-selected="m.value === data.period.from" t-esc="m.title"/>
                                </t>
                            </select>
                            <span class="text-muted">—</span>
                            <select class="form-select w-auto" aria-label="По місяць" t-on-change="(ev) => this.setTo(ev.target.value)">
                                <t t-foreach="data.options" t-as="m" t-key="m.value">
                                    <option t-att-value="m.value" t-att-selected="m.value === data.period.to" t-esc="m.title"/>
                                </t>
                            </select>
                        </div>
                        <div class="btn-group" role="group" aria-label="Одиниця">
                            <button type="button" class="btn" t-att-class="view.unit === 'hour' ? 'btn-primary' : 'btn-secondary'" t-on-click="() => this.setUnit('hour')">€ год</button>
                            <button type="button" class="btn" t-att-class="view.unit === 'month' ? 'btn-primary' : 'btn-secondary'" t-on-click="() => this.setUnit('month')">€ за місяць</button>
                        </div>
                    </div>

                    <t t-if="data.has">
                        <div class="card o_workset_profit_matrix_wrap">
                            <table class="table table-sm table-hover mb-0 o_workset_profit_matrix">
                                <thead>
                                    <tr>
                                        <th class="o_workset_profit_sticky">Лінія</th>
                                        <th t-foreach="data.months" t-as="m" t-key="m.value" class="text-end text-nowrap" t-esc="cap(m.name)"/>
                                        <th class="text-end text-nowrap" t-esc="data.period.text"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data.lines" t-as="line" t-key="line.id">
                                        <th class="o_workset_profit_sticky fw-normal text-nowrap" t-esc="line.name"/>
                                        <t t-foreach="line.cells" t-as="cell" t-key="cell.month">
                                            <td t-if="cell.has" class="text-end text-nowrap o_workset_profit_cell" t-att-class="cellClass(cell)" t-on-click="(ev) => this.onCell(ev, line, cell)">
                                                <t t-esc="cellValue(cell)"/><span class="o_workset_profit_cell_unit"><t t-if="view.unit === 'hour'"> € год</t><t t-else=""> €</t></span>
                                            </td>
                                            <td t-else="" class="text-end text-muted">—</td>
                                        </t>
                                        <td class="text-end text-nowrap fw-semibold">
                                            <t t-if="view.unit === 'hour'"><t t-if="line.total.net_ph !== null"><t t-esc="perHour(line.total.net_ph)"/><span class="o_workset_profit_cell_unit"> € год</span></t><t t-else="">—</t></t>
                                            <t t-else=""><t t-esc="euros(line.total.net)"/><span class="o_workset_profit_cell_unit"> €</span></t>
                                        </td>
                                    </tr>
                                </tbody>
                                <!-- нижче сірим: «Не розподілено», власники, звірка — € за місяць -->
                                <tbody class="text-muted o_workset_profit_company">
                                    <tr t-if="data.unallocated">
                                        <th class="o_workset_profit_sticky fw-normal text-nowrap">Не розподілено</th>
                                        <td t-foreach="data.unallocated.cells" t-as="c" t-key="c.month" class="text-end text-nowrap">
                                            <t t-if="c.has"><t t-esc="euros(c.amount)"/><span class="o_workset_profit_cell_unit"> €/міс</span></t><t t-else="">—</t>
                                        </td>
                                        <td class="text-end text-nowrap"><t t-esc="euros(data.unallocated.total)"/><span class="o_workset_profit_cell_unit"> €</span></td>
                                    </tr>
                                    <tr t-foreach="data.owners" t-as="o" t-key="o.code">
                                        <th class="o_workset_profit_sticky fw-normal text-nowrap">Власник <t t-esc="o.code"/></th>
                                        <td t-foreach="o.cells" t-as="c" t-key="c.month" class="text-end text-nowrap">
                                            <t t-if="c.has"><t t-esc="euros(c.amount)"/><span class="o_workset_profit_cell_unit"> €/міс</span></t><t t-else="">—</t>
                                        </td>
                                        <td class="text-end text-nowrap"><t t-esc="euros(o.total)"/><span class="o_workset_profit_cell_unit"> €</span></td>
                                    </tr>
                                    <tr>
                                        <th class="o_workset_profit_sticky fw-normal text-nowrap">Звірка з аналітикою</th>
                                        <td t-foreach="data.checks" t-as="c" t-key="c.month" class="text-end" t-att-title="c.text">
                                            <i t-if="c.state === 'ok'" class="fa fa-check"/>
                                            <i t-elif="c.state === 'bad'" class="fa fa-exclamation-triangle text-danger"/>
                                            <t t-else="">—</t>
                                        </td>
                                        <td/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="small text-muted text-end mt-2">
                            <span class="text-danger">червоний</span> — чисто нижче нуля, <span class="text-warning">жовтий</span> — упало більше ніж на
                            <t t-esc="plain(data.threshold)"/> € год порівняно з минулим місяцем; клік по клітинці — ланцюжок місяця.
                        </div>
                    </t>
                    <div t-else="" class="alert alert-info">немає даних за <t t-esc="cap(data.months[0].label)"/> — <t t-esc="data.months[data.months.length - 1].label"/></div>
                </div>
            </Layout>
        </div>
    </t>

    <!-- спливаюче вікно клітинки: ланцюжок місяця в обраній одиниці, «Відкрити рядки» — картка лінії -->
    <t t-name="workset_profit.ChainPopover">
        <div class="p-3 o_workset_profit_pop">
            <div class="fw-semibold mb-2" t-esc="props.title"/>
            <table class="table table-sm table-borderless mb-2">
                <tbody>
                    <tr t-foreach="props.steps" t-as="s" t-key="s.key" t-att-class="s.key === 'net' ? 'fw-semibold border-top' : ''">
                        <td class="ps-0" t-esc="s.label"/>
                        <td class="text-end text-nowrap pe-0"><t t-esc="props.format(s)"/> <t t-esc="props.unit"/></td>
                    </tr>
                </tbody>
            </table>
            <button type="button" class="btn btn-link p-0" t-on-click="open">Відкрити рядки</button>
        </div>
    </t>
</templates>
