<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Рядки розрахунку» (круг 1 — прості види; екрани з плитками й графіками круга 2 — workset_profit_screens_views.xml). Рядки пише лише код:
         створення, правка й видалення в списку вимкнені. Ланцюжок зліва направо: години → частка → оренда авто → житло → житло (вирахував
         замовник) → авто → паливо → інструмент → перевезення → чисто — усі доданки «чисто» видно за замовчуванням, тож видимі стовпці
         складаються в «Чисто»; поруч — гроші лінії й фонд. Не доданки (у фонд, буфер, сума рядка компанії, службові) — у «Додаткових
         стовпцях» (optional="hide"); у картці рядка нульові поля сховані -->
    <record id="view_month_list" model="ir.ui.view">
        <field name="name">workset.profit.month.list</field>
        <field name="model">workset.profit.month</field>
        <field name="arch" type="xml">
            <list string="Лінії × місяці" create="0" edit="0" delete="0" default_order="month desc, sort_key, name"
                  decoration-muted="row_kind in ('ignore', 'dkv')" decoration-danger="net &lt; 0" limit="200">
                <header>
                    <button name="action_recompute" type="object" string="Перерахувати" class="btn-primary" display="always"
                            groups="workset_profit.group_editor,base.group_system"/>
                    <button name="action_verify" type="object" string="Звірити" class="btn-secondary" display="always"/>
                </header>
                <field name="currency_id" column_invisible="1"/>
                <field name="row_kind" column_invisible="1"/>
                <field name="month" widget="date" options="{'numeric': True}"/>
                <field name="name"/>
                <field name="hours_total" optional="hide" sum="Разом"/>
                <field name="hours_rate" sum="Разом"/>
                <field name="hours_no_rate" optional="show" sum="Разом"/>
                <field name="share" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="car_rent" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="housing" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="housing_customer" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="auto" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="fuel" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="tool" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="transport" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="net" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" class="fw-semibold" sum="Разом"/>
                <field name="net_per_hour" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" class="fw-semibold"/>
                <!-- круг 4: нижче «чисто» — частки ZUS, PIT-4 і загальних фірм за годинами табеля й «Залишається» -->
                <field name="zus_amount" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="show" sum="Разом"/>
                <field name="office_amount" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="show" sum="Разом"/>
                <field name="remain" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="show" sum="Разом"/>
                <field name="remain_per_hour" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="show"/>
                <field name="partner_paid" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="show" sum="Разом"/>
                <field name="fund_paid" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="show" sum="Разом"/>
                <field name="fund_in" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="hide" sum="Разом"/>
                <field name="fund_left" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="hide" sum="Разом"/>
                <field name="housing_buffer" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="hide" sum="Разом"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="hide" sum="Разом"/>
                <field name="hint_kind" optional="hide"/>
                <field name="aal_amount" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="hide" sum="Разом"
                       groups="base.group_system"/>
                <field name="dkv_amount" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" optional="hide" sum="Разом"
                       groups="base.group_system"/>
                <!-- круг 2: рядок лінії — картка лінії (екран B) за цей місяць; до 2026 (calc.MIN_MONTH) картки немає — кнопки теж -->
                <button name="action_open_card" type="object" icon="fa-bar-chart" title="Картка лінії" invisible="row_kind != 'line' or month &lt; '2026-01-01'"/>
            </list>
        </field>
    </record>

    <!-- Картка рядка: ланцюжок лінії зверху вниз, поруч — що не в «чисто»; рядок компанії — сума, стаття, рахунок, картка; нульове — сховано -->
    <record id="view_month_form" model="ir.ui.view">
        <field name="name">workset.profit.month.form</field>
        <field name="model">workset.profit.month</field>
        <field name="arch" type="xml">
            <form string="Лінія × місяць" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_card" type="object" string="Картка лінії" class="btn-primary" invisible="row_kind != 'line' or month &lt; '2026-01-01'"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="d-flex align-items-baseline gap-2 flex-wrap text-muted">
                            <field name="month" widget="date" options="{'numeric': True}" readonly="1" class="w-auto"/>
                            <field name="row_kind" readonly="1" class="w-auto"/>
                        </div>
                    </div>
                    <group invisible="row_kind not in ('line', 'noline')">
                        <group name="chain" string="Ланцюжок">
                            <field name="hours_rate"/>
                            <field name="hours_no_rate" invisible="not hours_no_rate"/>
                            <field name="share" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="car_rent" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not car_rent"/>
                            <field name="housing" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not housing"/>
                            <field name="housing_customer" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not housing_customer"/>
                            <field name="auto" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not auto"/>
                            <field name="fuel" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not fuel"/>
                            <field name="tool" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not tool"/>
                            <field name="transport" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not transport"/>
                            <field name="net" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-semibold"/>
                            <field name="net_per_hour" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-semibold"/>
                            <field name="zus_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not zus_amount"/>
                            <field name="office_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not office_amount"/>
                            <field name="remain" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-semibold"
                                   invisible="not zus_amount and not office_amount"/>
                            <field name="remain_per_hour" widget="monetary" options="{'currency_field': 'currency_id'}"
                                   invisible="not zus_amount and not office_amount"/>
                        </group>
                        <group name="aside" string="Поруч, не в «чисто»"
                               invisible="not partner_paid and not fund_in and not fund_paid and not housing_buffer">
                            <field name="partner_paid" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not partner_paid"/>
                            <field name="fund_in" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not fund_in"/>
                            <field name="fund_paid" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not fund_paid"/>
                            <field name="fund_left" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not fund_in and not fund_paid"/>
                            <field name="housing_buffer" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not housing_buffer"/>
                        </group>
                    </group>
                    <group invisible="row_kind in ('line', 'noline')">
                        <group name="company" string="Рядок компанії">
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-semibold"/>
                            <field name="net" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="hint_kind" invisible="not hint_kind"/>
                        </group>
                        <group name="keys" string="Звідки">
                            <field name="analytic_id" invisible="not analytic_id"/>
                            <field name="account_id" invisible="not account_id"/>
                            <field name="card_id" invisible="not card_id"/>
                            <field name="customer_id" invisible="not customer_id"/>
                        </group>
                    </group>
                    <group invisible="row_kind != 'noline' or not customer_id">
                        <field name="customer_id"/>
                    </group>
                    <group name="check" string="Звірка" groups="base.group_system">
                        <field name="aal_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="dkv_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not dkv_amount"/>
                        <field name="tag" invisible="not tag"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Зведена: рядки × місяці, міра — «Чисто»; «Чисто, €/год» і «Порядок» — не міри (aggregator вимкнено) -->
    <record id="view_month_pivot" model="ir.ui.view">
        <field name="name">workset.profit.month.pivot</field>
        <field name="model">workset.profit.month</field>
        <field name="arch" type="xml">
            <pivot string="Прибутковість" sample="1">
                <field name="name" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="net" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_month_graph" model="ir.ui.view">
        <field name="name">workset.profit.month.graph</field>
        <field name="model">workset.profit.month</field>
        <field name="arch" type="xml">
            <graph string="Чисто по місяцях" type="bar" sample="1">
                <field name="month" interval="month"/>
                <field name="name"/>
                <field name="net" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_month_search" model="ir.ui.view">
        <field name="name">workset.profit.month.search</field>
        <field name="model">workset.profit.month</field>
        <field name="arch" type="xml">
            <search string="Лінії × місяці">
                <field name="name"/>
                <field name="line_id"/>
                <field name="analytic_id"/>
                <filter name="main" string="Без службових" domain="[('row_kind', 'not in', ['ignore', 'dkv'])]"/>
                <separator/>
                <filter name="lines" string="Лінії" domain="[('row_kind', '=', 'line')]"/>
                <filter name="company" string="Рядки компанії" domain="[('row_kind', 'in', ['noline', 'unallocated', 'office', 'owner'])]"/>
                <filter name="unallocated" string="Не розподілено" domain="[('row_kind', 'in', ['noline', 'unallocated'])]"/>
                <filter name="service" string="Службові" domain="[('row_kind', 'in', ['ignore', 'dkv'])]"/>
                <separator/>
                <filter name="no_rate" string="Є години без ставки" domain="[('hours_no_rate', '&gt;', 0)]"/>
                <filter name="negative" string="Чисто нижче нуля" domain="[('net', '&lt;', 0)]"/>
                <separator/>
                <!-- за замовчуванням — лише 2026 (calc.MIN_MONTH, рішення власника 06.11): рядки 2025 — зняти фільтр -->
                <filter name="from_2026" string="З 2026 року" domain="[('month', '&gt;=', '2026-01-01')]"/>
                <separator/>
                <filter name="month_filter" string="Місяць" date="month"/>
                <group>
                    <filter name="groupby_month" string="Місяць" context="{'group_by': 'month:month'}"/>
                    <filter name="groupby_line" string="Лінія" context="{'group_by': 'line_id'}"/>
                    <filter name="groupby_kind" string="Вид рядка" context="{'group_by': 'row_kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- круг 2: «Лінії × місяці» — екран C (action_matrix); цей список — «Рядки розрахунку» (усі рядки місяців, чипи «Огляду» відкривають його) -->
    <record id="action_months" model="ir.actions.act_window">
        <field name="name">Рядки розрахунку</field>
        <field name="res_model">workset.profit.month</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_month_search"/>
        <field name="context">{'search_default_main': 1, 'search_default_groupby_month': 1, 'search_default_from_2026': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Розрахунку ще немає</p>
            <p>Натисніть «Перерахувати»: останні місяці порахуються з табелів, ставок, аналітики й транзакцій DKV.</p>
        </field>
    </record>
</odoo>
