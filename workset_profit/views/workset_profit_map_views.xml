<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Розмітка аналітики»: ключі (вузол плану, стаття, рахунок, контрагент — заповнені збігаються всі) → вид, лінія, замовник. Найточніше
         правило — контрагент > стаття > рахунок > вузол (глибший — точніший). Вид підставляється підказкою за назвою, поки не обрано.
         Лінія й замовник не потрібні видам «Рахунок DKV», «Власник», «Офіс», «Не враховувати» -->
    <record id="view_map_list" model="ir.ui.view">
        <field name="name">workset.profit.analytic.map.list</field>
        <field name="model">workset.profit.analytic.map</field>
        <field name="arch" type="xml">
            <list string="Розмітка аналітики" editable="bottom" decoration-muted="not active or kind == 'ignore'" default_order="kind, line_id">
                <field name="active" column_invisible="1"/>
                <field name="plan_id" options="{'no_create': True}"/>
                <field name="analytic_id" options="{'no_create': True}"/>
                <field name="account_id" options="{'no_create': True}" optional="show"/>
                <field name="partner_id" options="{'no_create': True}" optional="show"/>
                <field name="kind"/>
                <field name="line_id" options="{'no_create': True}" invisible="kind in ('dkv_bill', 'owner', 'office', 'ignore')"/>
                <field name="customer_id" options="{'no_create': True}" optional="show" invisible="kind in ('dkv_bill', 'owner', 'office', 'ignore')"/>
                <field name="date_from" options="{'numeric': True}" optional="hide"/>
                <field name="date_to" options="{'numeric': True}" optional="hide"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_map_search" model="ir.ui.view">
        <field name="name">workset.profit.analytic.map.search</field>
        <field name="model">workset.profit.analytic.map</field>
        <field name="arch" type="xml">
            <search string="Розмітка аналітики">
                <field name="name"/>
                <field name="analytic_id"/>
                <field name="plan_id"/>
                <field name="line_id"/>
                <filter name="archived" string="В архіві" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="groupby_kind" string="Вид" context="{'group_by': 'kind'}"/>
                    <filter name="groupby_line" string="Лінія" context="{'group_by': 'line_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_map" model="ir.actions.act_window">
        <field name="name">Розмітка аналітики</field>
        <field name="res_model">workset.profit.analytic.map</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_map_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Розмітки ще немає — уся аналітика в «Не розподілено»</p>
            <p>Вузол плану, стаття, рахунок або контрагент → вид витрати й лінія.</p>
        </field>
    </record>
</odoo>
