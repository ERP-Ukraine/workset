<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Привілей «Прибутковість» поруч із «Ставками» (розділ кадрів форми користувача); склад груп пише інструмент штабу -->
    <record id="res_groups_privilege_profit" model="res.groups.privilege">
        <field name="name">Прибутковість</field>
        <field name="sequence">91</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_viewer" model="res.groups">
        <field name="name">Перегляд</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_profit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Бачить «Лінії × місяці», правила «Хто платить», картки й транзакції DKV, розмітку аналітики (без правки)</field>
    </record>

    <!-- Рівні привілею — ланцюжком: редактор включає перегляд -->
    <record id="group_editor" model="res.groups">
        <field name="name">Редактор</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_profit"/>
        <field name="implied_ids" eval="[(4, ref('group_viewer'))]"/>
        <field name="comment">Править «Хто платить», картки й транзакції DKV, розмітку аналітики; перераховує місяці кнопкою «Перерахувати»</field>
    </record>
</odoo>
