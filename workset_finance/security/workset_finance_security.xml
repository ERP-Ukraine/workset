<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Привілей «Фінанси» поруч зі «Ставками» й «Прибутковістю» (розділ кадрів форми користувача); склад груп пише інструмент штабу (посів) -->
    <record id="res_groups_privilege_finance" model="res.groups.privilege">
        <field name="name">Фінанси</field>
        <field name="sequence">92</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Три групи екранів ролей (круги 3–5): кожна бачить лише свій екран -->
    <record id="group_customers" model="res.groups">
        <field name="name">Замовники</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Екран «Замовники»: години, ставки клієнтів, дебіторка (круг 3)</field>
    </record>

    <record id="group_firms" model="res.groups">
        <field name="name">Фірми: закриття місяця</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Екран «Фірми: закриття місяця»: чернетки, банк, межфірмові (круг 4)</field>
    </record>

    <record id="group_payroll" model="res.groups">
        <field name="name">Зарплата й конверти</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Екран «Зарплата й конверти»: листи, табелі без рахунку, конверти (круг 5)</field>
    </record>

    <!-- Власник бачить усі екрани; редактор («Поправки») — це власник, який ще й править поправки і перераховує -->
    <record id="group_owner" model="res.groups">
        <field name="name">Власник</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_customers')), (4, ref('group_firms')), (4, ref('group_payroll'))]"/>
        <field name="comment">Бачить екран «Власник» (драбину прибутку, власників, II етап, неоплачено) і всі інші екрани. Лише ця група — і меню, і методи екрана</field>
    </record>

    <record id="group_editor" model="res.groups">
        <field name="name">Поправки</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_owner'))]"/>
        <field name="comment">Пише поправки драбини (1г, частки партнерів) з підставою; перераховує місяці кнопкою «Перерахувати»</field>
    </record>
</odoo>
