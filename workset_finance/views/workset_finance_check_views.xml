<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Звірка»: підсумок звірки місяця, який пише перерахунок; лише читання -->
    <record id="view_check_list" model="ir.ui.view">
        <field name="name">workset.finance.check.list</field>
        <field name="model">workset.finance.check</field>
        <field name="arch" type="xml">
            <list string="Звірка" create="0" edit="0" delete="0" decoration-danger="not ok">
                <field name="month" widget="date" options="{'numeric': True}"/>
                <field name="ok"/>
                <field name="text"/>
                <field name="checked_at"/>
            </list>
        </field>
    </record>

    <record id="action_checks" model="ir.actions.act_window">
        <field name="name">Звірка</field>
        <field name="res_model">workset.finance.check</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
