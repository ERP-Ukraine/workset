<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Рядки» — деталі кліків екрана «Власник»; пише лише код. Кнопка рядка відкриває записи, з яких він складений -->
    <record id="view_item_list" model="ir.ui.view">
        <field name="name">workset.finance.item.list</field>
        <field name="model">workset.finance.item</field>
        <field name="arch" type="xml">
            <list string="Рядки" create="0" edit="0" delete="0" default_order="month desc, kind, sort">
                <field name="currency_id" column_invisible="1"/>
                <field name="month" widget="date" options="{'numeric': True}"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="partner_id" optional="hide"/>
                <field name="analytic_id" optional="hide"/>
                <field name="line_id" optional="hide"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" sum="Разом"/>
                <field name="count" sum="Разом"/>
                <field name="note"/>
                <button name="action_open" type="object" icon="fa-list" title="Записи"/>
            </list>
        </field>
    </record>

    <record id="view_item_pivot" model="ir.ui.view">
        <field name="name">workset.finance.item.pivot</field>
        <field name="model">workset.finance.item</field>
        <field name="arch" type="xml">
            <pivot string="Рядки за видами" sample="1">
                <field name="kind" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_item_search" model="ir.ui.view">
        <field name="name">workset.finance.item.search</field>
        <field name="model">workset.finance.item</field>
        <field name="arch" type="xml">
            <search string="Рядки">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="analytic_id"/>
                <filter name="month_filter" string="Місяць" date="month"/>
                <group>
                    <filter name="groupby_month" string="Місяць" context="{'group_by': 'month:month'}"/>
                    <filter name="groupby_kind" string="Вид" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_items" model="ir.actions.act_window">
        <field name="name">Рядки</field>
        <field name="res_model">workset.finance.item</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_item_search"/>
        <field name="context">{'search_default_groupby_month': 1, 'search_default_groupby_kind': 1}</field>
    </record>
</odoo>
