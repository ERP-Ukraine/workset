<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: оновлення модуля не повертає розклад і «увімкнена» -->
    <data noupdate="1">
        <!-- «Фінанси: щоночі»: 23:30 UTC — після «Ставки: щодня» (22:15 UTC) і «Прибутковість: щоночі» (23:00 UTC); останні 3 місяці й поточний -->
        <record id="cron_recompute" model="ir.cron">
            <field name="name">Фінанси: щоночі</field>
            <field name="model_id" ref="model_workset_finance_month"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=23, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
