<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Привілей «Умови клієнтів» поруч зі «Ставками» й «Прибутковістю» (розділ кадрів форми користувача) -->
    <record id="res_groups_privilege_client" model="res.groups.privilege">
        <field name="name">Умови клієнтів</field>
        <field name="sequence">92</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_viewer" model="res.groups">
        <field name="name">Перегляд</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_client"/>
        <field name="comment">Бачить додаток «Умови клієнтів»: список замовників і екран «Умови клієнта» з частками (без правки). Лише ця група — і меню, і екран</field>
    </record>

    <!-- Рівні привілею — ланцюжком: редактор включає перегляд -->
    <record id="group_editor" model="res.groups">
        <field name="name">Редактор</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_client"/>
        <field name="implied_ids" eval="[(4, ref('group_viewer'))]"/>
        <field name="comment">Править договір, оплату, об'єкт і особливі домовленості замовника («Заповнити»), ставить «Позначити перевіреним»</field>
    </record>

    <!-- На час збирання (слово власника 07.11: «бачать картку: всі, з часткою… когда будет готово я решу по доступу») — «Перегляд» у
         кожного внутрішнього користувача. Зняти — одна правка: (4, …) → (3, …) у цьому записі й оновлення модуля -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_viewer'))]"/>
    </record>
</odoo>
