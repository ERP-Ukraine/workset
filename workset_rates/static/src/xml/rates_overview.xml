<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- «Огляд ставок» за макетом C (06.11): фільтр → смуга п'яти головних чисел (кожне — окремий відсік) → «пігулки» тривог → картки ліній
         одним рядом → зліва графіки («по місяцях», «Розподіл», «Хто знайшов»), справа тривоги. Сітки (scss) заповнюють ширину без порожніх
         полів; кольори — лише класи й змінні Bootstrap теми Odoo (світла й темна) і штатна палітра (колір лінії). Числа — з роздільником тисяч
         (money / int). Кожне число клікається: список ставок за описом сервера (open), число = рядки списку -->
    <t t-name="workset_rates.RatesOverview">
        <div class="o_action o_workset_rates_ov">
            <Layout display="{ controlPanel: {} }" className="'o_workset_rates_ov_main overflow-auto'">
                <div class="container-fluid py-3" t-if="data">
                    <!-- «Сьогодні вирішити» (блок Е, на показ): один рядок над усім — лише «Потрібна дія» (сервер, calc.decide_chips: гроші
                         першими, не більше 5, нулів немає). Чип — число крупно жирним і підпис звичайним; гроші — червона рамка й число без
                         заливки, решта — нейтральна рамка; вузько — чипи переносяться. Клік — те саме, що рядок «Тривог» (openChip).
                         Нічого вирішувати — один сірий рядок -->
                    <div class="o_workset_rates_ov_decide d-flex flex-wrap align-items-center gap-2 mb-3">
                        <t t-if="data.decide.length">
                            <span class="fw-semibold me-1">Сьогодні вирішити</span>
                            <t t-foreach="data.decide" t-as="chip" t-key="chip.key">
                                <button type="button" class="btn o_workset_rates_ov_decide_chip d-inline-flex align-items-baseline gap-1"
                                        t-att-class="(chip.money ? 'o_workset_rates_ov_decide_money' : '') + (chip.open.link === false ? ' pe-none' : '')"
                                        t-att-title="chip.open.check ? data.labels.tip_check : undefined" t-on-click="() => this.openChip(chip)">
                                    <span class="o_workset_rates_ov_decide_n" t-esc="int(chip.n)"/>
                                    <span t-esc="chip.label"/>
                                </button>
                            </t>
                        </t>
                        <span t-else="" class="text-muted">Сьогодні вирішувати нічого</span>
                    </div>

                    <div class="o_workset_rates_ov_filter d-flex flex-wrap align-items-center gap-2 mb-3">
                        <Dropdown>
                            <button class="btn btn-secondary">
                                <i class="fa fa-filter me-1"/>
                                <t t-if="filter.lines.length">Лінії: <t t-esc="filter.lines.length"/></t>
                                <t t-else="">Усі лінії</t>
                            </button>
                            <t t-set-slot="content">
                                <DropdownItem onSelected="() => this.allLines()">Усі лінії</DropdownItem>
                                <div class="dropdown-divider"/>
                                <t t-foreach="options.lines" t-as="line" t-key="line.id">
                                    <CheckboxItem checked="filter.lines.includes(line.id)" closingMode="'none'" onSelected="() => this.toggleLine(line.id)">
                                        <t t-esc="line.name"/>
                                    </CheckboxItem>
                                </t>
                            </t>
                        </Dropdown>
                        <select class="form-select w-auto" aria-label="Замовник" t-on-change="onCustomer">
                            <option value="0" t-att-selected="!filter.customer">Усі замовники</option>
                            <t t-foreach="options.customers" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-att-selected="filter.customer === c.id" t-esc="c.name"/>
                            </t>
                        </select>
                        <div class="btn-group" role="group" aria-label="Період">
                            <t t-foreach="months" t-as="m" t-key="m">
                                <button type="button" class="btn" t-att-class="filter.months === m ? 'btn-primary' : 'btn-secondary'"
                                        t-on-click="() => this.setMonths(m)"><t t-esc="m"/> міс.</button>
                            </t>
                        </div>
                        <div class="form-check form-switch mb-0 ms-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="o_workset_rates_ov_working"
                                   t-att-checked="filter.working" t-on-change="toggleWorking"/>
                            <label class="form-check-label" for="o_workset_rates_ov_working">Тільки працюють</label>
                        </div>
                    </div>

                    <!-- смуга п'яти головних чисел: кожне — окремий відсік із рамкою й проміжком між ними (слово власника 06.11: «визуального
                         разделения между цифрами нет»); підпис зверху, число крупно, «€/год» дрібно сірим; «Частка WorkSET» — колір бренду
                         (нижче мінімуму — червоним) -->
                    <t t-set="tiles" t-value="data.tiles"/>
                    <div class="o_workset_rates_ov_band mb-3">
                        <t t-call="workset_rates.OverviewBandCell">
                            <t t-set="key" t-value="'working'"/>
                            <t t-set="value" t-value="int(tiles.working)"/>
                            <t t-set="unit" t-value="false"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Працюють зараз</t>
                        </t>
                        <t t-call="workset_rates.OverviewBandCell">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_price)"/>
                            <t t-set="unit" t-value="true"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Платять нам</t>
                        </t>
                        <t t-call="workset_rates.OverviewBandCell">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_wage)"/>
                            <t t-set="unit" t-value="true"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Зарплата працівника</t>
                        </t>
                        <t t-call="workset_rates.OverviewBandCell">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_share)"/>
                            <t t-set="unit" t-value="true"/>
                            <t t-set="tone" t-value="tiles.share_tone === 'low' ? 'text-danger' : 'text-primary'"/>
                            <t t-set="label">Частка WorkSET</t>
                        </t>
                        <t t-call="workset_rates.OverviewBandCell">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_net)"/>
                            <t t-set="unit" t-value="true"/>
                            <t t-set="tone" t-value="tiles.net_tone === 'low' ? 'text-danger' : ''"/>
                            <t t-set="label">Після бонусів офісу</t>
                        </t>
                    </div>

                    <!-- «пігулки» (круг вигляду 06.11: лише важливе): лише з числом > 0 — нульових не видно, «Ставок» (усі діючі) прибрано; підпис,
                         лічильник у сірій капсулі справа, кольорова крапка тривоги; «Договір ≠ база» — з підказкою, чим його число відрізняється
                         від пунктів звірки в «Тривогах» -->
                    <div t-if="hasPills" class="o_workset_rates_ov_pills mb-4">
                        <t t-call="workset_rates.OverviewPill">
                            <t t-set="key" t-value="'contract_diff'"/>
                            <t t-set="value" t-value="tiles.contract_diff"/>
                            <t t-set="dot" t-value="'bg-danger'"/>
                            <t t-set="label">Договір ≠ база</t>
                            <t t-set="tip" t-value="data.labels.tip_contract"/>
                        </t>
                        <t t-call="workset_rates.OverviewPill">
                            <t t-set="key" t-value="'below_min'"/>
                            <t t-set="value" t-value="tiles.below_min"/>
                            <t t-set="dot" t-value="'bg-danger'"/>
                            <t t-set="label">Нижче мінімуму</t>
                        </t>
                        <t t-call="workset_rates.OverviewPill">
                            <t t-set="key" t-value="'to_check'"/>
                            <t t-set="value" t-value="tiles.to_check"/>
                            <t t-set="dot" t-value="'bg-warning'"/>
                            <t t-set="label">Перевірити</t>
                        </t>
                        <t t-call="workset_rates.OverviewPill">
                            <t t-set="key" t-value="'no_line'"/>
                            <t t-set="value" t-value="tiles.no_line"/>
                            <t t-set="dot" t-value="'bg-warning'"/>
                            <t t-set="label">Лінію не вказано</t>
                        </t>
                        <t t-call="workset_rates.OverviewPill">
                            <t t-set="key" t-value="'raises'"/>
                            <t t-set="value" t-value="tiles.raises"/>
                            <t t-set="dot" t-value="'bg-warning'"/>
                            <t t-set="label">Тимчасові зміни</t>
                        </t>
                    </div>

                    <!-- картки ліній (слово власника 06.11 «один ряд»; круг вигляду: усі лінії без прокрутки): ряд від більшого числа до
                         меншого (порядок — сервер), картка коротка — «лінія · людей · частка», решта (платять нам, після бонусів, якір,
                         посередник, фонд, нижче мінімуму) — у підказці; текст не обрізається (назва переноситься). Смуга зліва — колір лінії
                         (той самий, що ряд «По лініях»), червона крапка — є ставки нижче мінімуму. Клік — фільтр сторінки за лінією (ще раз —
                         усі лінії), значок списку — ставки лінії. Вузько — картки переносяться рядами (scss) -->
                    <t t-if="data.lines.length">
                        <div class="fs-4 fw-semibold mb-2">Лінії</div>
                        <div class="o_workset_rates_ov_lines mb-4">
                            <t t-foreach="data.lines" t-as="line" t-key="line.id">
                                <div role="button" tabindex="0" class="card text-start o_workset_rates_ov_line" t-att-class="isLineOn(line) ? 'o_workset_rates_ov_line_on' : ''"
                                     t-att-style="'border-left-color: ' + lineColor(line)" t-att-title="lineTip(line)"
                                     t-on-click="() => this.filterLine(line)" t-on-keydown="(ev) => this.onLineKey(ev, line)">
                                    <div class="o_workset_rates_ov_line_head d-flex align-items-start justify-content-between gap-1 w-100">
                                        <span class="fw-semibold o_workset_rates_ov_line_name" t-esc="line.name"/>
                                        <span class="d-flex align-items-center gap-1 flex-shrink-0">
                                            <span t-if="line.below_min" class="o_workset_rates_ov_dot rounded-circle bg-danger"/>
                                            <button type="button" class="btn btn-link p-0 text-muted o_workset_rates_ov_line_list" t-att-title="data.labels.line_list"
                                                    t-att-aria-label="data.labels.line_list" t-on-click.stop="() => this.openLine(line)">
                                                <i class="fa fa-list-ul"/>
                                            </button>
                                        </span>
                                    </div>
                                    <div class="o_workset_rates_ov_line_nums">
                                        <div class="o_workset_rates_ov_line_col">
                                            <div class="small text-muted">
                                                <t t-if="filter.working">людей</t>
                                                <t t-else="">ставок</t>
                                            </div>
                                            <div class="o_workset_rates_ov_line_num" t-esc="int(line.count)"/>
                                        </div>
                                        <div class="o_workset_rates_ov_line_col">
                                            <div class="small text-muted" t-esc="data.labels.share_short"/>
                                            <div class="o_workset_rates_ov_line_num" t-esc="money(line.avg_share)"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <div t-elif="!tiles.total" class="alert alert-info">За цим фільтром діючих ставок немає.</div>

                    <!-- графіки й тривоги (слово власника 06.11 ~18:1x): сітка 2 × 2 — рядок 1: «по місяцях» | «Розподіл частки», рядок 2:
                         «Хто знайшов» | «Тривоги»; висоти — за рядком сітки. Вузько — одна колонка в тому самому порядку -->
                    <div class="o_workset_rates_ov_panels">
                        <div class="card o_workset_rates_ov_panel">
                            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <span class="fw-semibold">Зарплата, платять нам, частка по місяцях</span>
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ряди">
                                    <button type="button" class="btn" t-att-class="state.byLine ? 'btn-secondary' : 'btn-primary'" t-on-click="() => this.setByLine(false)">Загалом</button>
                                    <button type="button" class="btn" t-att-class="state.byLine ? 'btn-primary' : 'btn-secondary'" t-on-click="() => this.setByLine(true)">По лініях</button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="o_workset_rates_ov_chart"><canvas t-ref="history"/></div>
                                <div class="small text-muted mt-2">Середні по ставках, що діяли на 1-ше число місяця; по лініях — сер. частка WorkSET.</div>
                            </div>
                        </div>
                        <div class="card o_workset_rates_ov_panel">
                            <div class="card-header fw-semibold">Розподіл частки WorkSET</div>
                            <div class="card-body">
                                <div class="o_workset_rates_ov_chart"><canvas t-ref="buckets"/></div>
                                <div class="small text-muted mt-2">Діючі ставки за часткою, €/год.</div>
                            </div>
                        </div>
                        <div class="card o_workset_rates_ov_panel">
                            <div class="card-header fw-semibold">Хто знайшов</div>
                            <div class="card-body">
                                <div class="o_workset_rates_ov_chart o_workset_rates_ov_chart_tall"><canvas t-ref="found"/></div>
                            </div>
                        </div>
                        <div class="card o_workset_rates_ov_panel o_workset_rates_ov_panel_alerts">
                            <div class="card-header fw-semibold">Тривоги</div>
                            <!-- круг вигляду 06.11: заголовок звірки — «пункти» (не «проблеми»), далі три групи: «Потрібна дія» (живі тривоги з
                                 рядками + розділи звірки про гроші й людей без ставки) і «Договір ≠ база — подробиці» — розгорнуті, «Неповні дані» —
                                 згорнута, сіра, із загальним числом. Нульового не видно. Числа звірки — «пункти» (підказка: чим вони відрізняються
                                 від плиток і списку «Ставки з розбіжностями»); підписи розділів — мовою користувача з сервера -->
                            <div class="list-group list-group-flush">
                                <button t-if="data.check" type="button" class="list-group-item list-group-item-action text-muted small" t-att-title="data.labels.tip_check"
                                        t-on-click="openCheck" t-esc="data.check.head"/>
                                <t t-foreach="alertGroups" t-as="g" t-key="g.key">
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2 o_workset_rates_ov_group"
                                            t-att-class="g.key === 'data' ? 'text-muted' : 'fw-semibold'" t-att-aria-expanded="isOpen(g) ? 'true' : 'false'"
                                            t-on-click="() => this.toggleGroup(g)">
                                        <span><i class="fa fa-fw" t-att-class="isOpen(g) ? 'fa-caret-down' : 'fa-caret-right'"/><t t-esc="g.title"/></span>
                                        <span t-if="g.key === 'data'" class="badge rounded-pill o_workset_rates_ov_count" t-att-title="data.labels.tip_check" t-esc="g.total_text"/>
                                    </button>
                                    <t t-if="isOpen(g)">
                                        <!-- живі тривоги (лише в «Потрібна дія»): заголовок — список, рядки — запис -->
                                        <t t-foreach="g.live" t-as="a" t-key="a.key">
                                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2 ps-4"
                                                    t-att-class="a.link === false ? 'pe-none' : ''" t-on-click="() => this.openAlert(a)">
                                                <span t-if="a.key === 'raise_soon'">Тимчасові зміни закінчуються ≤ 3 дні</span>
                                                <span t-elif="a.key === 'future'">Майбутні ставки на 7 днів</span>
                                                <span t-elif="a.key === 'no_line'">Лінію не вказано</span>
                                                <span t-elif="a.key === 'no_rate'">Працюють без ставки</span>
                                                <span t-elif="a.key === 'talk'">Переговорити</span>
                                                <span t-else="">Перевірити</span>
                                                <span class="badge rounded-pill text-bg-warning" t-esc="int(a.count)"/>
                                            </button>
                                            <t t-foreach="a.rows" t-as="row" t-key="row_index">
                                                <button type="button" class="list-group-item list-group-item-action o_workset_rates_ov_row" t-att-class="row.click === false ? 'pe-none' : ''"
                                                        t-on-click="() => this.openRow(a, row)">
                                                    <div t-esc="row.title"/>
                                                    <div class="small text-muted" t-esc="row.sub"/>
                                                </button>
                                            </t>
                                            <div t-if="a.count &gt; a.rows.length" class="list-group-item small text-muted o_workset_rates_ov_row">
                                                Показано <t t-esc="int(a.rows.length)"/> з <t t-esc="int(a.count)"/>
                                            </div>
                                        </t>
                                        <!-- розділи звірки групи: «N пунктів» -->
                                        <t t-foreach="g.items" t-as="it" t-key="it_index">
                                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between gap-2 ps-4 small"
                                                    t-att-class="g.key === 'data' ? 'text-muted' : ''" t-att-title="data.labels.tip_check" t-on-click="openCheck">
                                                <span t-esc="it.title"/>
                                                <span class="text-muted text-nowrap" t-esc="it.text"/>
                                            </button>
                                        </t>
                                    </t>
                                </t>
                                <div t-if="!hasAlerts" class="list-group-item text-muted">Тривог немає</div>
                            </div>
                        </div>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <!-- відсік смуги: картка з рамкою; підпис зверху, число fs-1 по центру, «€/год» дрібно сірим (unit); tone — клас кольору числа -->
    <t t-name="workset_rates.OverviewBandCell">
        <button type="button" class="card o_workset_rates_ov_band_cell text-center" t-on-click="() => this.openTile(key)">
            <span class="d-block text-muted text-truncate" t-out="label"/>
            <span class="d-block fs-1 fw-semibold lh-sm text-nowrap o_workset_rates_ov_num" t-att-class="tone">
                <t t-esc="value"/><span t-if="unit" class="o_workset_rates_ov_unit text-muted fw-normal">€/год</span>
            </span>
            <!-- «Тільки працюють» вимкнено: середні пораховано по всіх діючих ставках фільтра -->
            <span t-if="allRates(key)" class="small text-muted">по всіх діючих</span>
        </button>
    </t>

    <!-- «пігулка»: лише коли число > 0; підпис, лічильник у сірій капсулі справа, крапка dot (bg-danger / bg-warning); tip — підказка -->

    <t t-name="workset_rates.OverviewPill">
        <button t-if="value" type="button" class="card o_workset_rates_ov_pill flex-row align-items-center gap-2 px-3 py-2 text-start"
                t-att-title="tip or undefined" t-on-click="() => this.openTile(key)">
            <span class="flex-grow-1 text-truncate" t-out="label"/>
            <span class="badge rounded-pill o_workset_rates_ov_count" t-esc="int(value)"/>
            <span t-if="dot and value" class="o_workset_rates_ov_dot rounded-circle flex-shrink-0" t-att-class="dot"/>
        </button>
    </t>
</templates>
