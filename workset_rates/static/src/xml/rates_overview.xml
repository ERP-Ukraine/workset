<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- «Огляд ставок»: фільтр → плитки → картки ліній → графіки й тривоги. Сітки (scss) заповнюють ширину без порожніх полів:
         плитки — п'ять у ряд на широкому, дві — на вузькому, одна — на телефоні; кольори — лише класи Bootstrap теми Odoo -->
    <t t-name="workset_rates.RatesOverview">
        <div class="o_action o_workset_rates_ov">
            <Layout display="{ controlPanel: {} }" className="'o_workset_rates_ov_main overflow-auto'">
                <div class="container-fluid py-3" t-if="data">
                    <div class="o_workset_rates_ov_filter d-flex flex-wrap align-items-center gap-2 mb-3">
                        <Dropdown>
                            <button class="btn btn-secondary">
                                <i class="fa fa-filter me-1"/>
                                <t t-if="filter.lines.length">Лінії: <t t-esc="filter.lines.length"/></t>
                                <t t-else="">Усі лінії</t>
                            </button>
                            <t t-set-slot="content">
                                <DropdownItem onSelected="() => this.allLines()">Усі лінії</DropdownItem>
                                <div class="dropdown-divider"/>
                                <t t-foreach="options.lines" t-as="line" t-key="line.id">
                                    <CheckboxItem checked="filter.lines.includes(line.id)" closingMode="'none'" onSelected="() => this.toggleLine(line.id)">
                                        <t t-esc="line.name"/>
                                    </CheckboxItem>
                                </t>
                            </t>
                        </Dropdown>
                        <select class="form-select w-auto" aria-label="Замовник" t-on-change="onCustomer">
                            <option value="0" t-att-selected="!filter.customer">Усі замовники</option>
                            <t t-foreach="options.customers" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-att-selected="filter.customer === c.id" t-esc="c.name"/>
                            </t>
                        </select>
                        <div class="btn-group" role="group" aria-label="Період">
                            <t t-foreach="months" t-as="m" t-key="m">
                                <button type="button" class="btn" t-att-class="filter.months === m ? 'btn-primary' : 'btn-secondary'"
                                        t-on-click="() => this.setMonths(m)"><t t-esc="m"/> міс.</button>
                            </t>
                        </div>
                        <div class="form-check form-switch mb-0 ms-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="o_workset_rates_ov_working"
                                   t-att-checked="filter.working" t-on-change="toggleWorking"/>
                            <label class="form-check-label" for="o_workset_rates_ov_working">Тільки працюють</label>
                        </div>
                    </div>

                    <!-- плитки: клік — «Працюють зараз» / «Усі ставки» з тим самим фільтром -->
                    <t t-set="tiles" t-value="data.tiles"/>
                    <div class="o_workset_rates_ov_tiles mb-3">
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'working'"/>
                            <t t-set="value" t-value="tiles.working"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Працюють</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_wage) + ' €'"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Сер. на руки</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_price) + ' €'"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Сер. ціна</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_share) + ' €'"/>
                            <t t-set="tone" t-value="toneClass(tiles.share_tone)"/>
                            <t t-set="label">Сер. частка WorkSET</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'avg'"/>
                            <t t-set="value" t-value="money(tiles.avg_net) + ' €'"/>
                            <t t-set="tone" t-value="toneClass(tiles.net_tone)"/>
                            <t t-set="label">Сер. чиста частка</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'below_min'"/>
                            <t t-set="value" t-value="tiles.below_min"/>
                            <t t-set="tone" t-value="tiles.below_min ? 'border-danger bg-danger-subtle text-danger-emphasis' : ''"/>
                            <t t-set="label">Нижче мінімуму</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'raises'"/>
                            <t t-set="value" t-value="tiles.raises"/>
                            <t t-set="tone" t-value="tiles.raises ? 'border-warning bg-warning-subtle text-warning-emphasis' : ''"/>
                            <t t-set="label">Тимчасових</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'contract_diff'"/>
                            <t t-set="value" t-value="tiles.contract_diff"/>
                            <t t-set="tone" t-value="tiles.contract_diff ? 'border-warning bg-warning-subtle text-warning-emphasis' : ''"/>
                            <t t-set="label">Договір ≠ база</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'no_line'"/>
                            <t t-set="value" t-value="tiles.no_line"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Без лінії</t>
                        </t>
                        <t t-call="workset_rates.OverviewTile">
                            <t t-set="key" t-value="'to_check'"/>
                            <t t-set="value" t-value="tiles.to_check"/>
                            <t t-set="tone" t-value="''"/>
                            <t t-set="label">Перевірити</t>
                        </t>
                    </div>

                    <!-- картки ліній: клік — «Працюють зараз» по лінії -->
                    <div class="o_workset_rates_ov_lines mb-3" t-if="data.lines.length">
                        <t t-foreach="data.lines" t-as="line" t-key="line.id">
                            <button type="button" class="card text-start p-3 h-100 o_workset_rates_ov_line" t-on-click="() => this.openLine(line)">
                                <div class="d-flex align-items-center justify-content-between gap-2 w-100">
                                    <span class="fw-semibold fs-5 text-truncate" t-esc="line.name"/>
                                    <span t-if="line.anchor === 'markup'" class="badge rounded-pill text-bg-primary">надбавка</span>
                                    <span t-elif="line.anchor === 'tariff'" class="badge rounded-pill text-bg-secondary">тариф</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    <span>Працюють</span> <span class="fw-semibold text-body" t-esc="line.working"/>
                                    <t t-if="line.below_min"> · <span class="text-danger fw-semibold">нижче мінімуму <t t-esc="line.below_min"/></span></t>
                                </div>
                                <div class="d-flex flex-wrap gap-3 mt-2">
                                    <div><div class="fw-semibold" t-esc="money(line.avg_wage)"/><div class="small text-muted">на руки</div></div>
                                    <div><div class="fw-semibold" t-esc="money(line.avg_price)"/><div class="small text-muted">ціна</div></div>
                                    <div><div class="fw-semibold" t-esc="money(line.avg_share)"/><div class="small text-muted">частка</div></div>
                                </div>
                                <div class="small mt-2">
                                    <span class="text-muted">Посередник:</span>
                                    <span t-if="line.agent === 'yes'" class="text-success">є</span>
                                    <span t-elif="line.agent === 'expected'" class="text-warning-emphasis">очікується</span>
                                    <span t-else="" class="text-muted">немає</span>
                                </div>
                                <svg class="o_workset_rates_ov_spark w-100 text-primary mt-2" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
                                    <path t-att-d="line.spark" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"/>
                                </svg>
                            </button>
                        </t>
                    </div>
                    <div t-elif="!tiles.total" class="alert alert-info">За цим фільтром діючих ставок немає.</div>

                    <!-- графіки й тривоги -->
                    <div class="o_workset_rates_ov_panels">
                        <div class="card o_workset_rates_ov_panel o_workset_rates_ov_panel_wide">
                            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <span class="fw-semibold">На руки, ціна, частка по місяцях</span>
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ряди">
                                    <button type="button" class="btn" t-att-class="state.byLine ? 'btn-secondary' : 'btn-primary'" t-on-click="() => this.setByLine(false)">Загалом</button>
                                    <button type="button" class="btn" t-att-class="state.byLine ? 'btn-primary' : 'btn-secondary'" t-on-click="() => this.setByLine(true)">По лініях</button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="o_workset_rates_ov_chart"><canvas t-ref="history"/></div>
                                <div class="small text-muted mt-2">Ставки, що діяли на 1-ше число місяця; по лініях — сер. частка WorkSET.</div>
                            </div>
                        </div>
                        <div class="card o_workset_rates_ov_panel">
                            <div class="card-header fw-semibold">Розподіл частки WorkSET</div>
                            <div class="card-body">
                                <div class="o_workset_rates_ov_chart"><canvas t-ref="buckets"/></div>
                                <div class="small text-muted mt-2">Діючі ставки за часткою, €/год.</div>
                            </div>
                        </div>
                        <div class="card o_workset_rates_ov_panel">
                            <div class="card-header fw-semibold">Хто знайшов</div>
                            <div class="card-body">
                                <div class="o_workset_rates_ov_chart"><canvas t-ref="found"/></div>
                            </div>
                        </div>
                        <div class="card o_workset_rates_ov_panel o_workset_rates_ov_panel_alerts">
                            <div class="card-header fw-semibold">Тривоги</div>
                            <div class="list-group list-group-flush">
                                <t t-if="data.check">
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2" t-on-click="openCheck">
                                        <span>Звірка від <t t-esc="dateLabel(data.check.date)"/><t t-if="data.check.done"> · розібрано</t></span>
                                        <span class="badge rounded-pill" t-att-class="data.check.issues ? 'text-bg-warning' : 'text-bg-success'" t-esc="data.check.issues"/>
                                    </button>
                                    <t t-foreach="data.check.sections" t-as="s" t-key="s_index">
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between gap-2 ps-4 small" t-on-click="openCheck">
                                            <span t-esc="s.title"/>
                                            <span class="text-muted" t-esc="s.count"/>
                                        </button>
                                    </t>
                                </t>
                                <t t-foreach="data.alerts" t-as="a" t-key="a.key">
                                    <t t-if="a.count">
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2 fw-semibold" t-on-click="() => this.openAlert(a)">
                                            <span t-if="a.key === 'raise_soon'">Тимчасові зміни закінчуються ≤ 3 дні</span>
                                            <span t-elif="a.key === 'future'">Майбутні ставки на 7 днів</span>
                                            <span t-elif="a.key === 'no_line'">Ставки без лінії</span>
                                            <span t-else="">Перевірити</span>
                                            <span class="badge rounded-pill text-bg-warning" t-esc="a.count"/>
                                        </button>
                                        <t t-foreach="a.rows" t-as="row" t-key="row.id">
                                            <button type="button" class="list-group-item list-group-item-action ps-4" t-on-click="() => this.openRecord(a.model, row.id)">
                                                <div t-esc="row.title"/>
                                                <div class="small text-muted" t-esc="row.sub"/>
                                            </button>
                                        </t>
                                        <div t-if="a.count &gt; a.rows.length" class="list-group-item small text-muted ps-4">
                                            Показано <t t-esc="a.rows.length"/> з <t t-esc="a.count"/>
                                        </div>
                                    </t>
                                </t>
                                <div t-if="!hasAlerts" class="list-group-item text-muted">Тривог немає</div>
                            </div>
                        </div>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <!-- одна плитка: число fs-1 fw-semibold, підпис дрібно; tone — класи Bootstrap (червона / жовта) -->
    <t t-name="workset_rates.OverviewTile">
        <button type="button" class="o_workset_rates_ov_tile card text-start h-100 p-3" t-att-class="tone" t-on-click="() => this.openTile(key)">
            <span class="fs-1 fw-semibold lh-1 text-nowrap" t-esc="value"/>
            <span class="small mt-2" t-att-class="tone ? '' : 'text-muted'" t-out="label"/>
            <!-- «Тільки працюють» вимкнено: середні, «нижче мінімуму» й «тимчасових» пораховано по всіх діючих ставках фільтра -->
            <span t-if="allRates(key)" class="small text-muted">по всіх діючих</span>
        </button>
    </t>
</templates>
