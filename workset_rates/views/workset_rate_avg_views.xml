<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Середні» — перший екран: середні по тих, хто працює, за розрізом із панелі; кнопка рядка відкриває ставки розрізу -->
    <record id="view_avg_list" model="ir.ui.view">
        <field name="name">workset.rate.avg.list</field>
        <field name="model">workset.rate.avg</field>
        <field name="arch" type="xml">
            <list string="Середні" create="0" edit="0" delete="0" default_order="work_count desc">
                <field name="name" string="Розріз"/>
                <field name="work_count" string="Працюють"/>
                <field name="avg_wage" string="Сер. зарплата працівника"/>
                <field name="avg_price" string="Сер. платять нам"/>
                <field name="avg_share" string="Середня частка WorkSET"/>
                <field name="total" string="Усього ставок"/>
                <field name="zero_share" string="Без частки" optional="show"/>
                <field name="note" string="Станом на" optional="show"/>
                <button name="action_open_rates" type="object" string="Ставки" icon="fa-list"/>
            </list>
        </field>
    </record>

    <record id="view_avg_search" model="ir.ui.view">
        <field name="name">workset.rate.avg.search</field>
        <field name="model">workset.rate.avg</field>
        <field name="arch" type="xml">
            <search string="Середні">
                <field name="name" string="Розріз"/>
                <searchpanel>
                    <field name="dim" icon="fa-sitemap"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_avg" model="ir.actions.act_window">
        <field name="name">Середні</field>
        <field name="res_model">workset.rate.avg</field>
        <field name="view_mode">list</field>
        <field name="mobile_view_mode">list</field>
        <field name="context">{'searchpanel_default_dim': 'line'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Середніх ще немає</p>
            <p>Вони з’являться, коли будуть діючі ставки тих, хто працює.</p>
        </field>
    </record>
</odoo>
