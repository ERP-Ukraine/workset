<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Рядки карти проєктів (модель sale_timesheet): свої список, форма й пошук для «Рядки в проєктах» і «Проєкти без ставки» — лише перегляд;
         пріоритет 100 — стандартні місця (вкладка проєкту) їх не беруть -->
    <record id="view_map_list" model="ir.ui.view">
        <field name="name">workset.rates.map.list</field>
        <field name="model">project.sale.line.employee.map</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Рядки в проєктах" create="0" edit="0" delete="0">
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="partner_id" string="Замовник"/>
                <field name="employee_id"/>
                <field name="cost_currency_id" column_invisible="1"/>
                <field name="cost" widget="monetary" options="{'currency_field': 'cost_currency_id'}" string="Вартість години"/>
                <field name="is_cost_changed" string="Вартість змінено вручну" optional="hide"/>
                <field name="sale_line_id" optional="show"/>
                <field name="price_unit" string="Ціна в замовленні" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_map_form" model="ir.ui.view">
        <field name="name">workset.rates.map.form</field>
        <field name="model">project.sale.line.employee.map</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Рядок у проєкті" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="partner_id" string="Замовник" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="cost_currency_id" invisible="1"/>
                            <field name="cost" widget="monetary" options="{'currency_field': 'cost_currency_id'}" string="Вартість години" readonly="1"/>
                            <field name="is_cost_changed" string="Вартість змінено вручну" readonly="1"/>
                            <field name="sale_line_id" readonly="1"/>
                            <field name="price_unit" string="Ціна в замовленні" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted">Вартість години ставить автоматика зі ставки працівника в замовника; змінити — нова ставка в додатку «Ставки».</div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- «Працював за 60 днів» / «Без табелів» — id із контексту вікна (rates_recent_ids кладе дія) -->
    <record id="view_map_search" model="ir.ui.view">
        <field name="name">workset.rates.map.search</field>
        <field name="model">project.sale.line.employee.map</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Рядки в проєктах">
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="partner_id" string="Замовник"/>
                <filter name="recent" string="Працював за 60 днів" domain="[('id', 'in', context.get('rates_recent_ids', []))]"/>
                <filter name="stale" string="Без табелів 60 днів" domain="[('id', 'not in', context.get('rates_recent_ids', []))]"/>
                <group>
                    <filter name="groupby_customer" string="Замовник" context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_project" string="Проєкт" context="{'group_by': 'project_id'}"/>
                    <filter name="groupby_company" string="Фірма" context="{'group_by': 'company_id'}"/>
                    <filter name="groupby_employee" string="Працівник" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
