<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Список ставок: гроші — хранимі поля з усередненням (у рядку групи — середнє, у підвалі — середнє по списку); над списком — полоса
         підсумків (js_class). Минула — сірим; низька частка — червоним; «Добра частка» — зелена комірка частки -->
    <record id="view_rate_list" model="ir.ui.view">
        <field name="name">workset.rate.list</field>
        <field name="model">workset.rate</field>
        <field name="arch" type="xml">
            <list string="Ставки" js_class="workset_rates_list" decoration-muted="state == 'past'" decoration-danger="state != 'past' and share_level == 'low'"
                  sample="1" limit="200" default_order="line_id, customer_id, person_id, date_from desc">
                <field name="currency_id" column_invisible="1"/>
                <field name="share_level" column_invisible="1"/>
                <field name="person_id"/>
                <field name="others_note" optional="show"/>
                <field name="customer_id"/>
                <field name="line_id"/>
                <field name="work" widget="badge" decoration-success="work == 'work'" decoration-info="work == 'work_new'" decoration-warning="work == 'z_none'" decoration-muted="work == 'z_idle'" optional="show"/>
                <field name="last_hours" options="{'numeric': True}" optional="show"/>
                <field name="firms_text" optional="hide"/>
                <field name="projects_text" optional="hide"/>
                <field name="found_by" optional="show"/>
                <field name="wage" widget="monetary" options="{'currency_field': 'currency_id'}" avg="Середнє"/>
                <field name="agent_share" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" avg="Середнє"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}" avg="Середнє"/>
                <field name="our_share" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-semibold" decoration-success="share_level == 'good'" avg="Середнє"/>
                <field name="date_from" options="{'numeric': True}"/>
                <field name="date_to" options="{'numeric': True}" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'current'" decoration-info="state == 'future'" decoration-muted="state == 'past'"/>
                <field name="issues" string="Перевірити" decoration-warning="issues" optional="show"/>
                <field name="to_check" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Картка ставки за стандартом форми штабу: шапка (кнопки + статус), назва, «Перевірити» одним рядком, ключові цифри, блоки, вкладки службового -->
    <record id="view_rate_form" model="ir.ui.view">
        <field name="name">workset.rate.form</field>
        <field name="model">workset.rate</field>
        <field name="arch" type="xml">
            <form string="Ставка">
                <header>
                    <button name="action_new_from_date" type="object" string="Нова ставка з дати" class="btn-primary" invisible="not id or not active or state == 'past'" groups="workset_rates.group_editor,base.group_system"/>
                    <button name="action_apply_now" type="object" string="Застосувати зараз" class="btn-secondary" invisible="not id or not active" groups="workset_rates.group_editor,base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="future,current,past"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_maps" type="object" class="oe_stat_button" icon="fa-folder-open-o" invisible="not id or state != 'current'">
                            <field name="map_count" widget="statinfo" string="Рядків у проєктах"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="В архіві" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Минула" bg_color="text-bg-secondary" invisible="not active or state != 'past'"/>
                    <widget name="web_ribbon" title="Майбутня" bg_color="text-bg-secondary" invisible="not active or state != 'future'"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="share_level" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="person_id" placeholder="Працівник" options="{'no_create': True}" domain="[('employee_ids', '!=', False)]"/></h1>
                        <div class="d-flex align-items-baseline gap-2 flex-wrap text-muted" invisible="not subtitle and not others_note">
                            <field name="subtitle" readonly="1" class="w-auto"/>
                            <field name="others_note" readonly="1" invisible="not others_note" class="w-auto fw-semibold"/>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 flex-wrap fw-semibold text-warning my-2" role="alert" invisible="not issues">
                        <div><i class="fa fa-exclamation-circle me-1" role="img" title="Перевірити"/></div>
                        <div>Перевірити:</div>
                        <field name="issues" readonly="1" nolabel="1" class="w-auto"/>
                    </div>
                    <div class="row g-3 my-2" name="figures">
                        <div class="col-6 col-lg-3">
                            <div class="text-muted text-uppercase small fw-semibold">На руки</div>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap fs-1 fw-semibold lh-1">
                                <field name="wage" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" class="fs-1 fw-semibold o_input_5ch w-auto text-end"/>
                                <div class="fs-6 fw-normal text-muted">€/год</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="text-muted text-uppercase small">Ціна</div>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap fs-1 fw-semibold lh-1">
                                <field name="price" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" class="fs-1 fw-semibold o_input_5ch w-auto text-end"/>
                                <div class="fs-6 fw-normal text-muted">€/год</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3" invisible="not price">
                            <div class="text-muted text-uppercase small">Частка WorkSET</div>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap fs-1 fw-semibold lh-1">
                                <field name="our_share" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" class="fs-1 fw-semibold o_input_5ch w-auto text-end" readonly="1"
                                       decoration-danger="share_level == 'low'" decoration-success="share_level == 'good'"/>
                                <div class="fs-6 fw-normal text-muted">€/год</div>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group name="who" string="Сторони">
                            <label for="customer_id" string="Замовник" class="fw-semibold"/>
                            <field name="customer_id" nolabel="1" options="{'no_create': True}" domain="['|', ('is_company', '=', True), ('customer_rank', '&gt;', 0)]"/>
                            <field name="line_id" string="Лінія" options="{'no_create': True}"/>
                            <field name="found_by" string="Хто знайшов" widget="radio" options="{'horizontal': True}"/>
                            <field name="employee_summary" string="Картки у фірмах" readonly="1" invisible="not employee_summary"/>
                        </group>
                        <group name="money" string="Гроші">
                            <label for="agent_share" string="Посередник"/>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <field name="agent_share" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id', 'no_symbol': True}" class="o_input_7ch w-auto"/>
                                <div class="text-muted">€/год</div>
                            </div>
                            <field name="agent_note" string="Посередники" readonly="1" invisible="not agent_note"/>
                            <field name="rule_text" string="Правило лінії" readonly="1" invisible="not rule_text"/>
                            <label for="date_from" string="Ставка з" class="fw-semibold"/>
                            <field name="date_from" nolabel="1" options="{'numeric': True}"/>
                            <field name="date_to" string="Ставка до" readonly="1" invisible="not date_to" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <group>
                        <group name="source" string="Джерело">
                            <label for="source" string="Джерело" class="fw-semibold"/>
                            <field name="source" nolabel="1"/>
                            <field name="source_note" string="Звідки саме" placeholder="Напр.: група WhatsApp лінії, дата й час повідомлення"/>
                        </group>
                        <group name="work" string="Робота" invisible="not id">
                            <field name="work" string="Зараз" widget="badge" decoration-success="work == 'work'" decoration-info="work == 'work_new'" decoration-warning="work == 'z_none'" decoration-muted="work == 'z_idle'" readonly="1" invisible="not work"/>
                            <field name="last_hours" string="Останні години" readonly="1" options="{'numeric': True}"/>
                            <field name="firms_text" string="У фірмах" readonly="1" invisible="not firms_text"/>
                            <field name="projects_text" string="На об'єктах" readonly="1" invisible="not projects_text"/>
                        </group>
                    </group>
                    <group name="check" string="Перевірка" invisible="not id">
                        <field name="to_check" string="Перевірити"/>
                        <field name="check_reason" string="Що перевірити" invisible="not to_check"/>
                    </group>
                    <div class="mb-3">
                        <label for="note" string="Нотатка"/>
                        <field name="note" placeholder="Що домовилися, хто підтвердив"/>
                    </div>
                    <notebook>
                        <page name="control" string="Контроль" invisible="not id">
                            <div class="text-muted mb-2">Заповнюється само для діючої ставки: договір у картках, рядки в проєктах, ціна в замовленнях.</div>
                            <group invisible="state != 'current'">
                                <group name="contract" string="Договір">
                                    <label for="contract_wage" string="У договорі" invisible="not contract_wage"/>
                                    <div class="d-flex align-items-baseline gap-2 flex-wrap" invisible="not contract_wage">
                                        <field name="contract_wage" nolabel="1" readonly="1" class="o_input_7ch w-auto"/>
                                        <div class="text-muted">€/год</div>
                                    </div>
                                    <field name="contract_company_id" readonly="1"/>
                                    <field name="contract_ok" readonly="1"/>
                                </group>
                                <group name="projects" string="Проєкти">
                                    <field name="map_count" readonly="1"/>
                                    <field name="map_mismatch" readonly="1"/>
                                    <field name="order_price_ok" readonly="1"/>
                                </group>
                            </group>
                            <field name="control_html" readonly="1" nolabel="1" invisible="state != 'current'"/>
                        </page>
                        <page name="others" string="Інші ставки" invisible="not id or not others_note">
                            <div class="text-muted mb-2">Діючі ставки цього працівника в інших замовників і чи працює він там зараз.</div>
                            <field name="person_rate_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="customer_id"/>
                                    <field name="line_id"/>
                                    <field name="work" widget="badge" decoration-success="work == 'work'" decoration-info="work == 'work_new'" decoration-warning="work == 'z_none'" decoration-muted="work == 'z_idle'"/>
                                    <field name="last_hours" options="{'numeric': True}"/>
                                    <field name="wage" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="date_from" options="{'numeric': True}"/>
                                </list>
                            </field>
                        </page>
                        <page name="pair" string="Історія пари" invisible="not id">
                            <div class="text-muted mb-2">Інші ставки цієї пари «працівник × замовник» — від нової до старої.</div>
                            <field name="pair_rate_ids" readonly="1" nolabel="1" context="{'active_test': False}">
                                <list decoration-muted="state == 'past'" create="0" delete="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="date_from" options="{'numeric': True}"/>
                                    <field name="date_to" options="{'numeric': True}"/>
                                    <field name="wage" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="agent_share" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide"/>
                                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="our_share" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="state" widget="badge" decoration-success="state == 'current'" decoration-info="state == 'future'" decoration-muted="state == 'past'"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Дошка (і мобільний вид): групування за лінією; ті самі цифри, що у формі; над дошкою — полоса підсумків -->
    <record id="view_rate_kanban" model="ir.ui.view">
        <field name="name">workset.rate.kanban</field>
        <field name="model">workset.rate</field>
        <field name="arch" type="xml">
            <kanban js_class="workset_rates_kanban" default_group_by="line_id" quick_create="false" group_create="false" group_delete="false" group_edit="false"
                    records_draggable="false" archivable="false" sample="1">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="person_id" class="fw-semibold fs-5"/>
                        <field name="customer_id" class="text-muted"/>
                        <field name="formula" class="fs-5"/>
                        <div class="text-muted" invisible="not others_note"><field name="others_note"/></div>
                        <footer class="d-flex align-items-baseline gap-2 flex-wrap">
                            <field name="work" widget="badge" decoration-success="work == 'work'" decoration-info="work == 'work_new'" decoration-warning="work == 'z_none'" decoration-muted="work == 'z_idle'" invisible="not work"/>
                            <field name="state" widget="badge" decoration-success="state == 'current'" decoration-info="state == 'future'" decoration-muted="state == 'past'"/>
                            <field name="issues" class="fw-semibold"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Пошук: панель зліва — Робота (усі значення завжди) → Лінія (за числом тих, хто працює) → Замовник → Фірми; порожні значення
         прибирає модель (search_panel_select_range / search_panel_select_multi_range), без CSS -->
    <record id="view_rate_search" model="ir.ui.view">
        <field name="name">workset.rate.search</field>
        <field name="model">workset.rate</field>
        <field name="arch" type="xml">
            <search string="Ставки">
                <field name="person_id"/>
                <field name="customer_id"/>
                <field name="project_ids" string="Проєкт"/>
                <field name="company_ids" string="Фірма"/>
                <field name="line_id"/>
                <filter name="work_now" string="Працюють зараз" domain="[('work', 'in', ['work', 'work_new'])]"/>
                <filter name="work_idle" string="Не працюють" domain="[('work', '=', 'z_idle')]"/>
                <filter name="work_none" string="Годин не було" domain="[('work', '=', 'z_none')]"/>
                <separator/>
                <filter name="current" string="Діють" domain="[('state', '=', 'current')]"/>
                <filter name="future" string="Майбутні" domain="[('state', '=', 'future')]"/>
                <filter name="past" string="Минулі" domain="[('state', '=', 'past')]"/>
                <separator/>
                <filter name="share_low" string="Частка нижче мінімуму" help="Частка WorkSET ≤ 0 або нижче «Мінімуму частки» лінії" domain="[('share_level', '=', 'low')]"/>
                <filter name="share_good" string="Добра частка" help="Частка WorkSET не нижче «Доброї частки» лінії" domain="[('share_level', '=', 'good')]"/>
                <separator/>
                <filter name="not_rule" string="Не за правилом" domain="['|', ('rule_ok', '=', False), ('our_share', '&lt;=', 0)]"/>
                <filter name="contract_diff" string="≠ договір" domain="[('state', '=', 'current'), ('contract_ok', '=', False)]"/>
                <filter name="to_check" string="Перевірити" domain="[('to_check', '=', True)]"/>
                <separator/>
                <filter name="this_month" string="Змінені цього місяця" help="«Ставка з» у цьому місяці: нові ставки й зміни"
                        domain="[('date_from', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('date_from', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="archived" string="В архіві" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="groupby_line" string="Лінія" context="{'group_by': 'line_id'}"/>
                    <filter name="groupby_customer" string="Замовник" context="{'group_by': 'customer_id'}"/>
                    <filter name="groupby_company" string="Фірма" context="{'group_by': 'company_ids'}"/>
                    <filter name="groupby_project" string="Проєкт" context="{'group_by': 'project_ids'}"/>
                    <filter name="groupby_work" string="Робота" context="{'group_by': 'work'}"/>
                    <filter name="groupby_person" string="Працівник" context="{'group_by': 'person_id'}"/>
                    <filter name="groupby_state" string="Статус ставки" context="{'group_by': 'state'}"/>
                    <filter name="groupby_found" string="Хто знайшов" context="{'group_by': 'found_by'}"/>
                </group>
                <searchpanel>
                    <field name="work_group" icon="fa-clock-o" expand="1" enable_counters="1"/>
                    <field name="line_id" icon="fa-sitemap" enable_counters="1"/>
                    <field name="customer_id" icon="fa-handshake-o" enable_counters="1" hierarchize="0"/>
                    <field name="company_ids" select="multi" icon="fa-building-o" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Зведена й графік: гроші — середні (aggregator avg), не суми -->
    <record id="view_rate_pivot" model="ir.ui.view">
        <field name="name">workset.rate.pivot</field>
        <field name="model">workset.rate</field>
        <field name="arch" type="xml">
            <pivot string="Ставки" sample="1">
                <field name="line_id" type="row"/>
                <field name="work" type="col"/>
                <field name="our_share" type="measure"/>
                <field name="contract_wage" invisible="1"/>
                <field name="others_count" invisible="1"/>
                <field name="map_count" invisible="1"/>
                <field name="map_mismatch" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="view_rate_graph" model="ir.ui.view">
        <field name="name">workset.rate.graph</field>
        <field name="model">workset.rate</field>
        <field name="arch" type="xml">
            <graph string="Частка WorkSET по лініях" type="bar" sample="1">
                <field name="line_id"/>
                <field name="our_share" type="measure"/>
                <field name="contract_wage" invisible="1"/>
                <field name="others_count" invisible="1"/>
                <field name="map_count" invisible="1"/>
                <field name="map_mismatch" invisible="1"/>
            </graph>
        </field>
    </record>

    <!-- Дії -->
    <record id="action_rates_current" model="ir.actions.act_window">
        <field name="name">Працюють зараз</field>
        <field name="res_model">workset.rate</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="view_rate_search"/>
        <field name="context">{'search_default_current': 1, 'searchpanel_default_work_group': 'g1_work'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ставок ще немає</p>
            <p>Натисніть «Новий»: оберіть працівника й замовника, ціна підставиться за правилом лінії.</p>
        </field>
    </record>

    <record id="action_rates_all" model="ir.actions.act_window">
        <field name="name">Усі ставки</field>
        <field name="res_model">workset.rate</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="view_rate_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ставок ще немає</p>
            <p>Натисніть «Новий»: оберіть працівника й замовника, ціна підставиться за правилом лінії.</p>
        </field>
    </record>

    <record id="action_rates_review" model="ir.actions.act_window">
        <field name="name">Ставки з розбіжностями</field>
        <field name="res_model">workset.rate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rate_search"/>
        <field name="domain">[('state', 'in', ['current', 'future']), '|', '|', '|', '|', '|', ('to_check', '=', True), ('contract_ok', '=', False), ('map_mismatch', '>', 0), ('order_price_ok', '=', False), ('rule_ok', '=', False), ('our_share', '&lt;=', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Розбіжностей немає</p>
            <p>Діючі ставки збігаються з договорами, проєктами, замовленнями й правилами ліній.</p>
        </field>
    </record>

    <record id="action_rates_analytics" model="ir.actions.act_window">
        <field name="name">Аналітика ставок</field>
        <field name="res_model">workset.rate</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_rate_search"/>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ставок ще немає</p>
            <p>Натисніть «Новий»: оберіть працівника й замовника, ціна підставиться за правилом лінії.</p>
        </field>
    </record>

    <!-- «Звірка → Проєкти без ставки»: список збирається при відкритті (хранимого прапорця на карті немає) -->
    <record id="action_server_nomap" model="ir.actions.server">
        <field name="name">Проєкти без ставки</field>
        <field name="model_id" ref="model_workset_rate"/>
        <field name="state">code</field>
        <field name="code">action = model.rates_nomap_action()</field>
    </record>
</odoo>
